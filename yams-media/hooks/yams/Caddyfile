{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode gzip

	@sonarr path /sonarr /sonarr/*
	handle @sonarr {
		reverse_proxy yams-media_sonarr_1:8989
	}

	@radarr path /radarr /radarr/*
	handle @radarr {
		reverse_proxy yams-media_radarr_1:7878
	}

	@prowlarr path /prowlarr /prowlarr/*
	handle @prowlarr {
		reverse_proxy yams-media_prowlarr_1:9696
	}

	@bazarr path /bazarr /bazarr/*
	handle @bazarr {
		reverse_proxy yams-media_bazarr_1:6767
	}

	redir /qbittorrent /qbittorrent/ 308
	handle_path /qbittorrent/* {
		reverse_proxy yams-media_gluetun_1:8080 {
			header_up Host {upstream_hostport}
			header_up -Origin
			header_up -Referer
		}
	}

	handle {
		reverse_proxy yams-media_dashboard_1:8000
	}

	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta name="viewport" content="width=device-width,initial-scale=1"><body style="font-family:system-ui,sans-serif;background:#1b1726;color:#f3efe6;display:grid;place-items:center;min-height:100vh;margin:0;padding:24px"><div style="max-width:30rem"><h1 style="font-size:1.4rem">This part of YAMS isn't ready yet</h1><p style="color:#b3abc4;line-height:1.6">It may still be starting up (give it a minute), or it's waiting for your VPN. Downloads stay switched off until the VPN is connected.</p><p><a href="/" style="color:#ffc24b">Back to the YAMS dashboard</a></p></div>` 502
	}
}
